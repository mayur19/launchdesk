# ---------------------------------------------------------------------------
# Local development configuration. Copy to .env (run.sh does this for you).
# NEVER commit a real .env file. All values below are placeholders.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# HTTP
API_HOST=127.0.0.1
API_PORT=4103
WEB_PORT=5173
# Origin the browser uses; required for CSRF origin checks and cookies.
APP_ORIGIN=http://localhost:5173

# Database (local PostgreSQL). run.sh creates the database if it is missing.
DATABASE_URL=postgres://localhost:5432/launchdesk_dev
DATABASE_POOL_MAX=10

# Sessions. run.sh replaces this placeholder with a random local value.
# Must be at least 32 characters.
SESSION_SECRET=replace-me-with-a-long-random-local-only-value
SESSION_TTL_MINUTES=480
SESSION_COOKIE_NAME=sid

# Attachments (local disk only)
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
